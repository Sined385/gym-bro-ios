default_platform(:ios)

# Project-wide knobs.
SCHEME = 'GymBro'
XCODEPROJ = 'GymBro.xcodeproj'
RELEASE_BRANCH = 'main'
# Note: internal testers auto-receive every build at the app level, so there
# is no internal-group constant here. `groups` on upload_to_testflight is
# strictly external; the API rejects internal group names in that argument.
DEFAULT_EXTERNAL_GROUP = 'External Testers'

platform :ios do
  before_all do
    # Bail out early on anything that would make a half-baked release.
    ensure_git_status_clean
    ensure_git_branch(branch: RELEASE_BRANCH)
    app_store_connect_api_key(
      key_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_ID'),
      issuer_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_ISSUER_ID'),
      key_filepath: ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_FILEPATH'),
      is_key_content_base64: false,
      in_house: false,
    )
  end

  # ── Testers ─────────────────────────────────────────────
  # Build-number-only bump. Tag: "<version>(<build>)" e.g. 1.3(5).
  # Distributes the build to internal + external TestFlight groups.

  desc 'Bump build number, build, upload to TestFlight, tag.'
  lane :testers do
    increment_build_number(xcodeproj: XCODEPROJ)
    version = current_version
    build = current_build_number
    tag = "#{version}(#{build})"
    UI.message("Releasing tester build #{tag}")

    ensure_tag_available!(tag)

    build_ipa

    notes = ai_release_notes(mode: :testers, version: version, build: build.to_s)

    upload_to_testflight(
      changelog: notes,
      distribute_external: true,
      notify_external_testers: true,
      groups: [ENV.fetch('TESTFLIGHT_EXTERNAL_GROUP', DEFAULT_EXTERNAL_GROUP)],
      reject_build_waiting_for_review: false,
    )

    finalize_git(tag: tag, message: "fastlane: bump to #{tag}")
  end

  # ── General release ─────────────────────────────────────
  # Minor version bump, build resets to 1. Tag: "<version>" e.g. 1.4.
  # AI also writes a new ## v<version> section into release-notes.txt and
  # the bump commit picks it up.

  desc 'Bump minor version, build, upload to TestFlight, tag, update release notes.'
  lane :release do
    # fastlane's built-in increment_version_number walks every target,
    # syncs them to the lowest MARKETING_VERSION baseline (the Watch
    # target's 1.0), and downgrades the iOS app — there's no `target:`
    # option to scope it (only the plugin-based variant supports it).
    # Use the Xcodeproj gem directly to touch only the GymJam target's
    # MARKETING_VERSION across all build configurations.
    require 'xcodeproj'
    project = Xcodeproj::Project.open(XCODEPROJ)
    gym_target = project.targets.find { |t| t.name == 'GymJam' } or
      UI.user_error!("GymJam target not found in #{XCODEPROJ}")
    gym_target.build_configurations.each do |config|
      current = config.build_settings['MARKETING_VERSION'] || '1.0'
      parts = current.split('.').map(&:to_i)
      parts << 0 while parts.length < 2
      parts[1] += 1
      config.build_settings['MARKETING_VERSION'] = parts.join('.')
    end
    project.save

    # Build-number reset stays unscoped so iOS + Watch keep matching
    # CFBundleVersion (the pattern Apple accepted on the 1.4(9) build).
    increment_build_number(build_number: '1', xcodeproj: XCODEPROJ)
    version = current_version
    build = current_build_number
    tag = version
    UI.message("Releasing general #{tag}")

    ensure_tag_available!(tag)

    build_ipa

    notes = ai_release_notes(mode: :general, version: version, build: build.to_s)
    UI.important('General release notes draft — copy into release-notes.txt manually:')
    UI.message(notes)
    testflight_changelog = extract_testflight_changelog(notes)

    upload_to_testflight(
      changelog: testflight_changelog,
      distribute_external: true,
      notify_external_testers: true,
      groups: [ENV.fetch('TESTFLIGHT_EXTERNAL_GROUP', DEFAULT_EXTERNAL_GROUP)],
      reject_build_waiting_for_review: false,
    )

    # release-notes.txt lives in the OUTER gym-bro repo (alongside the
    # api/ios/dashboard sub-repos), not inside gym-bro-ios. The AI-drafted
    # general notes are shown in the lane output for the human to copy
    # into release-notes.txt manually; fastlane does not touch that file.
    finalize_git(tag: tag, message: "fastlane: release #{tag}")
  end

  # ── Helpers ─────────────────────────────────────────────

  def current_version
    get_version_number(xcodeproj: XCODEPROJ, target: 'GymJam')
  end

  def current_build_number
    get_build_number(xcodeproj: XCODEPROJ)
  end

  def ensure_tag_available!(tag)
    existing = sh("cd .. && git tag --list '#{tag}'", log: false).strip
    UI.user_error!("Tag #{tag} already exists — bump didn't take or you're re-running.") unless existing.empty?
  end

  def build_ipa
    build_app(
      scheme: SCHEME,
      configuration: 'Release',
      export_method: 'app-store',
      clean: true,
      output_directory: 'fastlane/build',
      output_name: 'GymJam.ipa',
      include_bitcode: false,
      include_symbols: true,
      # Pin to iOS — without an explicit destination, xcodebuild also tries
      # the scheme's visionOS destination and bails because the visionOS SDK
      # isn't installed locally.
      destination: 'generic/platform=iOS',
    )
  end

  def finalize_git(tag:, message:)
    commit_version_bump(
      message: "#{message} [skip ci]",
      xcodeproj: XCODEPROJ,
      force: true,
    )
    add_git_tag(tag: tag)
    push_to_git_remote(remote: 'origin', local_branch: RELEASE_BRANCH, remote_branch: RELEASE_BRANCH, tags: true)
  end

  # Strip the markdown heading/dashes so the TestFlight changelog box gets
  # plain bullets instead of "## v1.4" + "---" noise.
  def extract_testflight_changelog(general_notes)
    lines = general_notes.lines
    cleaned = lines.reject do |l|
      stripped = l.strip
      stripped.start_with?('##') || stripped == '---' || stripped.empty?
    end
    cleaned.take(15).join.strip
  end

end
