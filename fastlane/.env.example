# Copy this file to fastlane/.env and fill in the values.
# fastlane/.env is gitignored; this file stays checked in as documentation.

# App Store Connect API key — create at App Store Connect → Users and Access
# → Keys (App Manager role). Drop the .p8 file at fastlane/AuthKey.p8.
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=fastlane/AuthKey.p8

# TestFlight group names — override only if your groups in App Store Connect
# are named something other than the defaults.
TESTFLIGHT_INTERNAL_GROUP=Internal Testers
TESTFLIGHT_EXTERNAL_GROUP=External Testers
